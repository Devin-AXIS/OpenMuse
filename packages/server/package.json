    "@deepseek-ai/dsh-sdk-protocol": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@hono/node-server": "2.1.1",
    "better-auth": "1.6.11",
    "croner": "10.0.1",
    "dotenv": "17.2.4",
    "e2b": "2.51.0",
    "hono": "4.13.9",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/pg": "8.15.5",
    "tsx": "4.23.15",
    "typescript": "5.8.3"
