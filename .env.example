NEXT_PUBLIC_CLOUD_API_URL=http://localhost:3100
OPENMUSE_SERVER_PORT=3100
OPENMUSE_SERVER_HOST=0.0.0.0
OPENMUSE_WEB_ORIGINS=http://localhost:3102,http://127.0.0.1:3102,capacitor://localhost
DATABASE_URL=postgres://openmuse:openmuse@localhost:5433/openmuse
DATABASE_POOL_SIZE=24
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# In development, OTPs are printed by the server. Production must configure an SMS provider.
NODE_ENV=development
DEEPSEEK_API_KEY=
OPENMUSE_DSH_PROVIDER=deepseek-official
OPENMUSE_DSH_MODEL=deepseek-flash
OPENMUSE_DSH_IDLE_MS=300000
OPENMUSE_DATA_DIR=./data

# Local development uses a host DSH process. Public deployments must use isolated E2B sandboxes.
OPENMUSE_SANDBOX_PROVIDER=local
OPENMUSE_E2B_API_KEY=
OPENMUSE_E2B_API_URL=
OPENMUSE_E2B_SANDBOX_URL=
OPENMUSE_E2B_VOLUME_API_URL=
OPENMUSE_E2B_TEMPLATE=openmuse-dsh
OPENMUSE_E2B_RUN_TIMEOUT_MS=1200000
OPENMUSE_LLM_DAILY_REQUESTS=400
OPENMUSE_LLM_DAILY_BYTES=104857600
